{
  "name": "circuitbin",
  "description": "Self-hosted electronics component inventory with real photos, color-coded pinouts, stock-matched projects & AI part identification",
  "license": "MIT",
  "homepage": "https://github.com/msalexms/circuitbin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msalexms/circuitbin.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch-path=server server/index.mjs",
    "dibujos": "node scripts/dibujos.mjs",
    "pines": "node scripts/pines.mjs && node scripts/catalogo.mjs",
    "catalogo": "node scripts/catalogo.mjs",
    "copia": "node scripts/copia.mjs",
    "ia-simulada": "node scripts/ia-simulada.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "tipos": "node scripts/tipos.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/openai-compatible": "^3.0.85",
    "ai": "^7.0.163",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
